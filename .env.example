# @BotFather dan olingan bot tokeni
BOT_TOKEN=123456789:AAExampleTokenHere

# Admin(lar) Telegram ID si, bir nechta bo'lsa vergul bilan ajrating
ADMIN_IDS=123456789,987654321

# Kinolar joylashgan kanal ID si (bot o'sha kanalda ADMIN bo'lishi shart)
# Kanal ID sini olish uchun @userinfobot yoki shunga o'xshash botlardan foydalaning
CHANNEL_ID=-1001234567890

# Majburiy obuna kanali (ixtiyoriy, bo'sh qoldirish mumkin)
REQUIRED_CHANNEL=@your_channel

# Ma'lumotlar bazasi fayli nomi (o'zgartirish shart emas)
DB_PATH=bot.db

# Start xabarida yuboriladigan premium animatsiyali stiker file_id
# (o'z stikeringizni botga yuborib, uning file_id sini olishingiz mumkin)
STICKER_ID=

# Zaxira nusxalar saqlanadigan papka
BACKUP_DIR=backups
